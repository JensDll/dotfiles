pkgname=hyprshutdown
pkgver=f70097e670adddb5a02fb0994804532d6b483b72
pkgrel=1
pkgdesc='A graceful shutdown utility for Hyprland'
arch=(x86_64)
url=https://github.com/hyprwm/hyprshutdown
license=('BSD-3-Clause')
depends=(
  hyprtoolkit
  'hyprutils>=0.11.0'
  pixman
  libdrm
  glaze
)
makedepends=(cmake ninja pkgconf clang lld)
source=(git+https://github.com/hyprwm/hyprshutdown.git#commit="${pkgver}"?signed)
sha512sums=(af670c9c1505468dc3a127c57cf983e124eb58eaadc87f1ef2fb23809a228aecaae0426e604c8282a6b79c2125cb1ea855b785c4c114abda552571074148c301)
validpgpkeys=(
  968479A1AFF927E37D1A566BB5690EEEBB952194
)

build() {
  cmake \
    -B build \
    -S "${pkgname}" \
    -G Ninja \
    -D CMAKE_BUILD_TYPE:STRING=Release \
    -D CMAKE_C_COMPILER:STRING=clang \
    -D CMAKE_CXX_COMPILER:STRING=clang++ \
    -D CMAKE_LINKER_TYPE:STRING=LLD \
    -D CMAKE_INTERPROCEDURAL_OPTIMIZATION:BOOL=ON
  cmake --build build
}

package() {
  cmake --install build --prefix "${pkgdir}"/usr
  install -D -m 644 "${pkgname}"/LICENSE -t "${pkgdir}"/usr/share/licenses/"${pkgname}"
}
