pkgname=neovim
pkgver=0.12.5
pkgrel=1
pkgdesc='Fork of Vim aiming to improve user experience, plugins, and GUIs'
arch=(x86_64)
url=https://neovim.io
license=(Apache-2.0 LicenseRef-vim)
depends=(
  libluv
  libutf8proc
  libuv
  lua51-lpeg
  luajit
  tree-sitter
  tree-sitter-c
  tree-sitter-lua
  tree-sitter-markdown
  tree-sitter-query
  tree-sitter-vim
  tree-sitter-vimdoc
)
makedepends=(
  cmake
  git
  ninja
)
optdepends=(
  'wl-clipboard: wayland clipboard provider'
)
source=(
  https://github.com/neovim/neovim/archive/refs/tags/v"${pkgver}".tar.gz
)
sha512sums=(
  94b681395a60ce06ec327c578f875b828256891d660c9e34f1f9c0b48577d2f85cbe0c2a8f377fba3b068782cc54dcaeda046045a2bdb7166340e12cf3d70354
)

prepare() {
  cmake \
    --install-prefix /usr \
    -B build \
    -S "neovim-${pkgver}" \
    -G Ninja \
    -D CMAKE_BUILD_TYPE:STRING=Release \
    -D CMAKE_C_COMPILER:STRING=clang \
    -D CMAKE_LINKER_TYPE:STRING=LLD \
    -D CMAKE_INTERPROCEDURAL_OPTIMIZATION:BOOL=ON \
    -D ENABLE_UNIBILIUM:BOOL=OFF
}

build() {
  cmake --build build
}

check() {
  ./build/bin/nvim --version
  ./build/bin/nvim --headless -u NONE -i NONE \
    --cmd 'echo "Echo check\n"' \
    --cmd q
}

package() {
  cmake --install build --prefix "${pkgdir}"/usr
  ln -s /usr/lib/tree_sitter "${pkgdir}"/usr/share/nvim/runtime/parser
  install -D -m 644 -t "${pkgdir}"/usr/share/licenses/"${pkgname}" neovim-"${pkgver}"/LICENSE.txt
  install -D -m 644 <(
    cat <<<'set runtimepath+=/usr/share/vim/vimfiles,/usr/share/vim/vimfiles/after'
  ) "${pkgdir}"/etc/xdg/nvim/sysinit.vim
}
