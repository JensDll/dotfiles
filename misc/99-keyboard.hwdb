# See comments at the start of: /usr/lib/udev/hwdb.d/60-keyboard.hwdb

# Input device ID: bus 0x3 vendor 0x46a product 0x11 version 0x111
# Values determined by: sudo evtest /dev/input/event4

# Input device ID: bus 0x3 vendor 0x46d product 0x408a version 0x111
# Values determined by: sudo evtest /dev/input/event5

# Cherry
evdev:input:b0003v046Ap0011*
 KEYBOARD_KEY_700e4=esc # Map right control to escape

# MX Keys
evdev:input:b0003v046Dp408A*
 KEYBOARD_KEY_700e4=esc
